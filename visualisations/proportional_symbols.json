{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 450,
  "title": "Creative Participation Filtered by Performing Art/Activity",
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "activity",
      "value": "Music",
      "bind": {
        "input": "select",
        "options": ["Music", "Dance", "Theatre"],
        "name": "Select activity: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "../data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME26 != 'Other Territories' && datum.properties.STE_NAME26 != 'Outside Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "../data/participation_long_lat.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "activity === 'Music' ? toNumber(datum.Music) : activity === 'Dance' ? toNumber(datum.Dance) : toNumber(datum.Theatre)",
          "as": "SelectedParticipation"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "color": "#2878b5",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "SelectedParticipation",
          "type": "quantitative",
          "scale": {
            "range": [50, 1200]
          },
          "legend": {
            "title": "Participation (%)"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "SelectedParticipation",
            "type": "quantitative",
            "title": "Participation (%)"
          }
        ]
      }
    }
  ]
}